%==============================================================================
\chapter{Bibliographie commentée et sources}
\label{chap:biblio}
%==============================================================================

Toutes les valeurs numériques de ce cours proviennent de la cosmologie
Planck 2018, telle qu'implémentée dans \texttt{astropy.cosmology.Planck18}.
Les sources sont organisées par thème.

\section{Mesure des paramètres cosmologiques}

\paragraph{Planck 2018 (paramètres de référence).}
N.~Aghanim \emph{et al.} (Planck Collaboration), \emph{Planck 2018 results.
VI. Cosmological parameters}, Astron.\ Astrophys.\ \textbf{641}, A6 (2020).
\href{https://doi.org/10.1051/0004-6361/201833910}{DOI}~|
\href{https://arxiv.org/abs/1807.06209}{arXiv:1807.06209}.
Source primaire des paramètres utilisés
(Tableau 2, colonne TT,TE,EE+lowE+lensing+BAO).

\paragraph{SH0ES (tension de Hubble).}
A.~G.~Riess \emph{et al.}, ApJL \textbf{934}, L7 (2022).
\href{https://arxiv.org/abs/2112.04510}{arXiv:2112.04510}.

\paragraph{Découverte de l'accélération.}
A.~G.~Riess \emph{et al.}, AJ \textbf{116}, 1009 (1998)~;
S.~Perlmutter \emph{et al.}, ApJ \textbf{517}, 565 (1999).
Prix Nobel 2011.

\section{Formules de distance cosmologique}

\paragraph{Référence pratique.}
D.~W.~Hogg, \emph{Distance measures in cosmology}, arXiv:astro-ph/9905116
(1999, mis à jour 2000).
\href{https://arxiv.org/abs/astro-ph/9905116}{arXiv}.
Toutes les formules de distance dans un document de 11 pages~; bibliographie d'usage quotidien.

\paragraph{Théorème de réciprocité.}
I.~M.~H.~Etherington, \emph{On the definition of distance in general relativity},
Phil.\ Mag.\ \textbf{15}, 761 (1933)~; réimprimé dans Gen.\ Rel.\ Grav.\
\textbf{39}, 1055 (2007).

\paragraph{Approche pédagogique.}
E.~L.~Wright, \emph{A Cosmology Calculator for the World Wide Web},
PASP \textbf{118}, 1711 (2006).
\href{https://arxiv.org/abs/astro-ph/0609593}{arXiv:astro-ph/0609593}.
Description de la calculatrice
\href{https://www.astro.ucla.edu/~wright/CosmoCalc.html}
     {astro.ucla.edu/$\sim$wright/CosmoCalc.html} encore très utilisée.

\section{Articles fondateurs}

\paragraph{Équations de Friedmann.}
A.~Friedmann, \emph{Über die Krümmung des Raumes}, Z.\ Phys.\ \textbf{10},
377 (1922).

\paragraph{Loi de Lemaître--Hubble.}
G.~Lemaître, Annales de la Société Scientifique de Bruxelles \textbf{A47}, 49
(1927). Première proposition d'une loi vitesse--distance, deux ans avant Hubble.
\hfill
E.~Hubble, PNAS \textbf{15}, 168 (1929). Mise en évidence observationnelle.

\paragraph{Métrique FLRW.}
H.~P.~Robertson, ApJ \textbf{82}, 284 (1935)~; A.~G.~Walker, Proc.\ London Math.\
Soc.\ \textbf{42}, 90 (1937). Caractérisation rigoureuse.

\section{Ouvrages de référence}

\paragraph{Cours d'introduction (M1 / cycle ingénieur).}
\begin{description}[leftmargin=1.6cm,itemsep=2pt]
\item[Ryden 2017] B.~Ryden, \emph{Introduction to Cosmology}, 2$^{\text{e}}$
  éd., Cambridge University Press. Le standard pour démarrer.
\item[Liddle 2015] A.~Liddle, \emph{An Introduction to Modern Cosmology},
  3$^{\text{e}}$ éd., Wiley. Très court, accessible.
\end{description}

\paragraph{Cours avancé (M2 / doctorat).}
\begin{description}[leftmargin=1.6cm,itemsep=2pt]
\item[Mukhanov 2005] V.~Mukhanov, \emph{Physical Foundations of Cosmology},
  Cambridge.
\item[Dodelson \& Schmidt 2020] S.~Dodelson and F.~Schmidt, \emph{Modern
  Cosmology}, 2$^{\text{e}}$ éd., Academic Press. Référence M2 actuelle pour
  les perturbations et le CMB.
\item[Weinberg 2008] S.~Weinberg, \emph{Cosmology}, Oxford. Magistral.
\item[Carroll 2004] S.~M.~Carroll, \emph{Spacetime and Geometry}, Addison-Wesley.
  Chapitre 8 = cosmologie depuis la RG.
\end{description}

\section{Discussion conceptuelle}

\paragraph{Origine du redshift cosmologique.}
E.~F.~Bunn and D.~W.~Hogg, \emph{The kinematic origin of the cosmological redshift},
Am.\ J.\ Phys.\ \textbf{77}, 688 (2009).
\href{https://arxiv.org/abs/0808.1081}{arXiv:0808.1081}.
Discussion accessible sur l'interprétation Doppler vs. expansion.

\paragraph{Vitesses de récession.}
T.~M.~Davis and C.~H.~Lineweaver, \emph{Expanding Confusion: Common
Misconceptions of Cosmological Horizons and the Superluminal Expansion of the
Universe}, PASA \textbf{21}, 97 (2004).
\href{https://arxiv.org/abs/astro-ph/0310808}{arXiv:astro-ph/0310808}.
Référence sur les vitesses superluminiques et les horizons.

\paragraph{Distance-duality.}
B.~A.~Bassett and M.~Kunz, \emph{Cosmic distance-duality as a probe of exotic
physics and acceleration}, Phys.\ Rev.\ D \textbf{69}, 101305 (2004).

\section{Outils en ligne}

\begin{itemize}[topsep=2pt,leftmargin=*]
\item \textbf{NED} (NASA/IPAC Extragalactic Database) Cosmology Calculator\\
  \href{https://ned.ipac.caltech.edu/help/cosmology_calc.html}{ned.ipac.caltech.edu / help / cosmology\_calc.html}
\item \textbf{Ned Wright (UCLA) Cosmology Calculator}\\
  \href{https://www.astro.ucla.edu/~wright/CosmoCalc.html}{astro.ucla.edu / $\sim$wright / CosmoCalc.html}
\item \textbf{ICRAR Cosmology Calculator}\\
  \href{https://cosmocalc.icrar.org/}{cosmocalc.icrar.org}
\item \textbf{Astropy} (documentation cosmologie)\\
  \href{https://docs.astropy.org/en/stable/cosmology/}{docs.astropy.org / en / stable / cosmology}
\end{itemize}

\section{Code source}

La bibliothèque \texttt{astropy.cosmology} implémente toutes les formules de
ce cours. La cosmologie \texttt{Planck18} est définie dans
\texttt{astropy/cosmology/realizations.py}. Le code source est disponible
sur \href{https://github.com/astropy/astropy}{github.com/astropy/astropy}.

Le programme \texttt{redshift\_distance\_gui.py} qui accompagne ce cours
utilise PyQt6 pour l'interface et pyqtgraph pour le tracé vectoriel.

